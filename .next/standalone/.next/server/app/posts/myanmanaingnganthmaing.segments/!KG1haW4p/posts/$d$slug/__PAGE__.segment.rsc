4%E1%80%BA%E1%80%84%E1%80%B6%E1%81%8F_%E1%80%A1%E1%80%99%E1%80%8A%E1%80%BA%E1%80%99%E1%80%BB%E1%80%AC%E1%80%B8"}],"style":"normal"},{"_key":"28ce9f85a987","_type":"block","children":[{"_key":"89b6677935ff","_type":"span","marks":[],"text":"၁၉၈၉ ခုနှစ်တွင် စစ်အစိုးရက အင်္ဂလိပ်ဘာသာဖြင့် (‌Burma) ဘားမားကို မြန်မာဟု ပြောင်းလဲရန် "},{"_key":"fd576ebee02e","_type":"span","marks":["edc5c47eac19"],"text":"ဆုံးဖြတ်ခဲ့သည်"},{"_key":"3e774e807d1a","_type":"span","marks":[],"text":"။"}],"markDefs":[{"_key":"edc5c47eac19","_type":"link","href":"https://my.wikipedia.org/wiki/%E1%80%85%E1%80%80%E1%80%AC%E1%80%B8%E1%80%9B%E1%80%95%E1%80%BA%E1%80%99%E1%80%BB%E1%80%AC%E1%80%B8_%E1%80%95%E1%80%BC%E1%80%B1%E1%80%AC%E1%80%84%E1%80%BA%E1%80%B8%E1%80%9C%E1%80%B2%E1%80%9E%E1%80%90%E1%80%BA%E1%80%99%E1%80%BE%E1%80%90%E1%80%BA%E1%80%9E%E1%80%8A%E1%80%B7%E1%80%BA_%E1%80%A5%E1%80%95%E1%80%92%E1%80%B1"}],"style":"normal"},{"_key":"defc51185664","_type":"block","children":[{"_key":"0a9e87af5990","_type":"span","marks":[],"text":"အနောက်နိုင်ငံများက စစ်အစိုးရကို လက်မခံသည့်အတွက် "},{"_key":"10cce561b805","_type":"span","marks":["8a12860779f1"],"text":"အင်္ဂလိပ်ဘာသာ"},{"_key":"c8e0054bac7b","_type":"span","marks":[],"text":"ဖြင့် နိုင်ငံအမည်အား တရားဝင်ပြောင်းလဲရန် လုပ်ပိုင်ခွင့်မရှိဟု ယူဆကြသည်။"},{"_key":"d5089126b70e","_type":"span","marks":["15e7b0ea069c"],"text":"[၂၃]"},{"_key":"d1bc29b49490","_type":"span","marks":[],"text":" ထို့ကြောင့် ၎င်းတို့သည် မြန်မာဘာသာဖြင့် မြန်မာနိုင်ငံဟု လက်ခံသုံးစွဲသော်လည်း အင်္ဂလိပ်ဘာသာဖြင့် ဘားမားဟု ဆက်လက်သုံးစွဲလျက်ရှိသည်။ အင်္ဂလိပ်ဘာသာဖြင့် သုံးနှုန်းသည့်အခါ သုံးစွဲသူအလိုက် \"ဘားမား\"သို့မဟုတ် \"မြန်မာ\"ကို ရွေးချယ်သုံးစွဲကြပြီး နည်းပညာအားဖြင့် အပြန်အလှန် ဖလှယ်သုံးစွဲနိုင်သော စကားလုံးများ ဖြစ်ကြသည်။"}],"markDefs":[{"_key":"8a12860779f1","_type":"link","href":"https://my.wikipedia.org/wiki/%E1%80%A1%E1%80%84%E1%80%BA%E1%80%B9%E1%80%82%E1%80%9C%E1%80%AD%E1%80%95%E1%80%BA%E1%80%98%E1%80%AC%E1%80%9E%E1%80%AC"},{"_key":"15e7b0ea069c","_type":"link","href":"https://my.wikipedia.org/wiki/%E1%80%99%E1%80%BC%E1%80%94%E1%80%BA%E1%80%99%E1%80%AC%E1%80%94%E1%80%AD%E1%80%AF%E1%80%84%E1%80%BA%E1%80%84%E1%80%B6#cite_note-steinberg-23"}],"style":"normal"},{"_key":"0200e8231ac1","_type":"block","children":[{"_key":"30696535ec6d","_type":"span","marks":[],"text":"နိုင်ငံပြင်ပ "},{"_key":"e2feaccf4e73","_type":"span","marks":["03afbb9d4b0d"],"text":"သတင်း"},{"_key":"4ba69fe7db7e","_type":"span","marks":[],"text":"ဌာနကြီးများ ဖြစ်သည့် ဘီ⁠ဘီစီ (BBC)၊ ဝေါလ်စထရိဂျာနယ် ("},{"_key":"69ee23785727","_type":"span","marks":["em"],"text":"Wall Street Journal"},{"_key":"8ee7209b71d6","_type":"span","marks":[],"text":") နှင့် ဖိုင်နင်းရှယ်တိုင်မ်း ("},{"_key":"69afd1cf236e","_type":"span","marks":["em"],"text":"Financial Times"},{"_key":"618f78df76e7","_type":"span","marks":[],"text":") တို့အပြင် အမေရိကန်နှင့် ဂရိတ်ဗြိတိန်အစိုးရများကပါ မြန်မာနိုင်ငံကို ဘားမားဟု ဆက်လက်ခေါ်ဝေါ်လျက်ရှိပြီး စီအင်အင် (CNN)၊ အီကော်နော်မစ် ("},{"_key":"5afb945a585c","_type":"span","marks":["em","93532ad98e11"],"text":"The Economist"},{"_key":"2c150effb90f","_type":"span","marks":[],"text":")၊ နှင့် နယူးယောက်တိုင်မ်း ("},{"_key":"1bd07024a574","_type":"span","marks":["em"],"text":"New York Times"},{"_key":"4e152d642fc4","_type":"span","marks":[],"text":") တို့ကမူ မြန်မာဟူသည့် အသုံးအနှုန်းကို တိုင်းပြည်အဖြစ်လည်း ‌‌ကောင်း၊ Burmese ဟူသည့် အင်္ဂလိပ်စကားလုံးကို နာမဝိသေသနအဖြစ်လည်းကောင်း လက်ခံကျင့်သုံးနေပြီဖြစ်သည်။"},{"_key":"636c62fdac42","_type":"span","marks":["80215f54032e"],"text":"[၂၄]"},{"_key":"f15f7e78c9a2","_type":"span","marks":["3fdb8df434fb"],"text":"[၂၅]"}],"markDefs":[{"_key":"03afbb9d4b0d","_type":"link","href":"https://my.wikipedia.org/wiki/%E1%80%9E%E1%80%90%E1%80%84%E1%80%BA%E1%80%B8"},{"_key":"93532ad98e11","_type":"link","href":"https://my.wikipedia.org/wiki/The_Economist"},{"_key":"80215f54032e","_type":"link","href":"https://my.wikipedia.org/wiki/%E1%80%99%E1%80%BC%E1%80%94%E1%80%BA%E1%80%99%E1%80%AC%E1%80%94%E1%80%AD%E1%80%AF%E1%80%84%E1%80%BA%E1%80%84%E1%80%B6#ci